NODE_ENV=development
APP_URL=

# Klassio-Zugang
LEHRERAPP_ACCESS_TEAM=
LEHRERAPP_ACCESS_EXTERNAL=
SESSION_SECRET=

# Schul-E-Mail-Login: kommaseparierte erlaubte Domains, ohne @
LEHRERAPP_ALLOWED_EMAIL_DOMAINS=vsfoa.vobs.at
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Serverseitige Klassio-Daten (z. B. Lehrerzimmer). Auf dem vServer auf ein persistentes Verzeichnis setzen.
KLASSIO_DATA_DIR=./data

# KI
GEMINI_API_KEY=

# OneDrive
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Canva
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional: eigener 32+ Zeichen Schlüssel; sonst wird SESSION_SECRET zur Ableitung verwendet.
CANVA_TOKEN_ENCRYPTION_KEY=
