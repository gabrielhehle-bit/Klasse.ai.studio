NODE_ENV=development
APP_URL=

# Klassio-Zugang
LEHRERAPP_ACCESS_TEAM=
LEHRERAPP_ACCESS_EXTERNAL=
SESSION_SECRET=

# E-Mail-Login: jede gültige E-Mail-Adresse kann ein persönliches Klassio-Konto verwenden.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optionaler Bootstrap für bereits verifizierte Schul-Domains.
# Die produktive Zuordnung läuft über das serverseitige Schulregister.
# Mehrere Domains kommasepariert; exakte Domains, keine Provider-Sammeldomain nötig.
KLASSIO_VERIFIED_SCHOOL_DOMAINS=

# Mindestens 32 zufällige Zeichen. Nur für die administrative Freigabe
# neuer Schul-Verifizierungsanfragen; niemals an Browser oder Lehrpersonen geben.
KLASSIO_SCHOOL_ADMIN_TOKEN=

# Veralteter Fallback für bestehende Installationen; nicht für neue Setups verwenden.
LEHRERAPP_ALLOWED_EMAIL_DOMAINS=

# Serverseitige Klassio-Daten (z. B. Lehrerzimmer). Auf dem vServer auf ein persistentes Verzeichnis setzen.
KLASSIO_DATA_DIR=./data

# Freiwillige Unterstützung / PayPal
# Nur HTTPS-Links von paypal.com bzw. paypal.me werden akzeptiert.
KLASSIO_PAYPAL_ONE_TIME_URL=
KLASSIO_PAYPAL_MONTHLY_URL=
KLASSIO_PAYPAL_YEARLY_URL=
# Für echte PayPal-Abonnements (Client-ID ist öffentlich; niemals Client-Secret hier eintragen).
KLASSIO_PAYPAL_CLIENT_ID=
KLASSIO_PAYPAL_MONTHLY_PLAN_ID=
KLASSIO_PAYPAL_YEARLY_PLAN_ID=
# Separater Admin-Token für die ausdrücklich freigegebene Unterstützer:innen-Liste.
KLASSIO_SUPPORT_ADMIN_TOKEN=

# KI
GEMINI_API_KEY=

# OneDrive
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Canva
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional: eigener 32+ Zeichen Schlüssel; sonst wird SESSION_SECRET zur Ableitung verwendet.
CANVA_TOKEN_ENCRYPTION_KEY=
