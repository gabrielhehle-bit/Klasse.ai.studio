NODE_ENV=development
APP_URL=
# Optional: only the addresses/CIDRs of trusted upstream proxies (e.g. 127.0.0.1).
# Never set '*' or a public/wildcard range; leave blank if unsure.
# The Node app must not be reachable directly from the public Internet.
# If unset, login rate limits identify the direct socket peer; all clients behind
# one proxy can share its limit until its address is explicitly configured.
KLASSIO_TRUSTED_PROXY_ADDRESSES=

# Klassio-Zugang
LEHRERAPP_ACCESS_TEAM=
LEHRERAPP_ACCESS_EXTERNAL=
SESSION_SECRET=

# E-Mail-Login: jede gültige E-Mail-Adresse kann ein persönliches Klassio-Konto verwenden.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Eine einzige bestehende Mailbox: noreply@klassio.at ist sowohl Absender
# für Anmeldecodes als auch Kontaktadresse bei Schulmail-/Verifizierungsproblemen.
# Hinweis: Trotz des Namens "noreply" muss diese Mailbox Antworten empfangen können.
SMTP_FROM="KLASSIO <noreply@klassio.at>"

# Optionaler Bootstrap für bereits verifizierte Schul-Domains.
# Die produktive Zuordnung läuft über das serverseitige Schulregister.
# Mehrere Domains kommasepariert; exakte Domains, keine Provider-Sammeldomain nötig.
KLASSIO_VERIFIED_SCHOOL_DOMAINS=

# E-Mail-Adresse(n) der Klassio-Administration, kommasepariert.
# Diese Konten sehen in Einstellungen > Konto & Schulmail die Schulverwaltung
# und erhalten neue Verifizierungsanfragen per Mail. Fallback: SMTP_USER.
KLASSIO_SCHOOL_ADMIN_EMAILS=

# Optionaler technischer API-Adminzugang mit mindestens 32 zufälligen Zeichen.
# Niemals an Browser oder Lehrpersonen geben.
KLASSIO_SCHOOL_ADMIN_TOKEN=

# Veralteter Fallback für bestehende Installationen; nicht für neue Setups verwenden.
LEHRERAPP_ALLOWED_EMAIL_DOMAINS=

# Serverseitige Klassio-Daten (z. B. Lehrerzimmer). Auf dem vServer auf ein persistentes Verzeichnis setzen.
KLASSIO_DATA_DIR=./data

# Getrennter verschlüsselter Materialspeicher (VORBEREITUNG, NOCH NICHT FREIGEBEN).
# Standard bleibt AUS: erst nach vollständigem, getestetem Anhang-Backup/Restore,
# Sync-/Offline-Migration, Bestandsprüfung, Rechte- und Speicher-Quota-Audit aktivieren.
# Das Vorhandensein dieser API bedeutet NICHT, dass bestehende Materialdateien bereits migriert sind.
KLASSIO_ENCRYPTED_ATTACHMENTS_ENABLED=false

# KI
# Datenschutz-Notstopp: externe KI bleibt standardmäßig AUS, selbst wenn GEMINI_API_KEY gesetzt ist.
# Erst nach Freigabe durch den Verantwortlichen, geprüfter Auftragsverarbeitung und
# eigener Prüfung aller Text-/Kontext-Workflows ausdrücklich auf true setzen.
# Auch dann bleiben individuelle Portfolios/Notenprognosen, PDF-Importe und Bilder gesperrt.
KLASSIO_AI_EXTERNAL_ENABLED=false
# Niemals in den Browser oder ins Git-Repository schreiben; nur serverseitig setzen.
GEMINI_API_KEY=
# Kostenbremse: pro angemeldeter Person/Session und für den gesamten Server.
KLASSIO_AI_DAILY_USER_LIMIT=20
KLASSIO_AI_DAILY_GLOBAL_LIMIT=200
KLASSIO_AI_PER_MINUTE_LIMIT=5

# OneDrive
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Canva: Zugang über ein gültig angemeldetes Klassio-E-Mail-Konto.
# Im Canva Developer Portal den exakten Callback APP_URL/api/canva/callback
# und die Scopes design:meta:read, design:content:read, design:content:write eintragen.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# STRIKT PERSISTENT: KLASSIO_DATA_DIR muss außerhalb wechselnder Release-Verzeichnisse liegen;
# die AES-GCM-OAuth-Sitzungen befinden sich dort unter canva-tokens/<account-id>.json.
# Optional separater, stabiler Zufallsschlüssel mit mindestens 32 Zeichen.
# Falls leer, wird der persistente SESSION_SECRET abgeleitet.
# Eine Änderung des Schlüssels erfordert erneute Canva-Verbindung jeder Lehrperson.
CANVA_TOKEN_ENCRYPTION_KEY=
